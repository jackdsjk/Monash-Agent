{
  "name": "cove-desktop",
  "version": "0.1.0",
  "description": "Cove local-first campus triage desktop app",
  "main": "main.cjs",
  "type": "commonjs",
  "private": true,
  "author": "Cove",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node scripts/prepare-resources.cjs",
    "pack": "npm run prepare:resources && electron-builder --dir",
    "dist:mac": "npm run prepare:resources && electron-builder --mac dmg zip",
    "dist:win": "npm run prepare:resources && electron-builder --win zip --x64",
    "build:launcher": "npm run prepare:resources && node scripts/build-launcher.cjs",
    "e2e": "node e2e/desktop-smoke.mjs"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1"
  },
  "build": {
    "appId": "com.cove.local",
    "productName": "Cove",
    "copyright": "Cove",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../webapp/dist",
        "to": "webapp"
      },
      {
        "from": "resources/local-service",
        "to": "local-service"
      },
      {
        "from": "resources/local-service/node_modules",
        "to": "local-service/node_modules"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Cove-${version}-${arch}.${ext}",
      "identity": null
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "zip"
      ],
      "artifactName": "Cove-${version}-win-${arch}.${ext}"
    },
    "dmg": {
      "title": "Cove",
      "icon": "assets/icon.icns"
    }
  }
}
